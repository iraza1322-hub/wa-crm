# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side routes.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-encryption-key

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# UI language: en | ko | pt | es (defaults to en)
NEXT_PUBLIC_APP_LOCALE=en

# ============================================================
# OPTIONAL — only needed if you use specific features.
# ============================================================

# Defense-in-depth allow-list for invite hostnames (comma-separated)
# ALLOWED_INVITE_HOSTS=your-app.vercel.app

# Shared secret protecting GET /api/automations/cron (for scheduled pinger)
# AUTOMATION_CRON_SECRET=your-cron-secret

# Meta App ID (Meta for Developers → App Settings → Basic)
# Required only for template image-header uploads
# META_APP_ID=your-meta-app-id

# Set to true to mock WhatsApp template submissions in dev/CI
# WHATSAPP_TEMPLATES_DRY_RUN=false
